---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const currentHash = Astro.url.hash;

// Detectar si es enlace a sección (#algo)
const isSection = href?.toString().startsWith('#');

// Activo para páginas normales
const isActivePage = !isSection && (href === pathname || href === '/' + (subpath?.[0] || ''));

// Activo para secciones (compara el hash actual)
const isActiveSection = isSection && href === currentHash;

const isActive = isActivePage || isActiveSection;
---

<a 
    href={href} 
    data-scroll={isSection ? href?.toString().replace('#', '') : undefined}
    class:list={[className, { active: isActive }]}
    {...props}
>
    <slot />
</a>

<style>
    a {
        display: inline-block;
        text-decoration: none;
        padding: 0.4rem 0.9rem;
        color: rgba(255, 255, 255, 0.88);
        font-size: 1.2rem;
        font-weight: 600;
        border-radius: 6px;
        transition: color 0.2s, background 0.2s;
        white-space: nowrap;
        letter-spacing: 0.01em;
    }
    a:hover {
        color: var(--secundario-amarillo);
        background: rgba(255, 255, 255, 0.08);
    }
    a.active {
        color: var(--secundario-amarillo);
        background: rgba(233, 189, 21, 0.15);
        font-weight: 700;
    }
</style>