            padding-left: 0.8rem;
        }
 
        .mobile-links .m-icon {
            width: 40px;
            height: 40px;
            background: rgba(233, 189, 21, 0.1);
            border: 1px solid rgba(233, 189, 21, 0.25);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            flex-shrink: 0;
        }
 
        .mobile-cta-area {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
 
        .btn-mobile-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0.9rem 1rem;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s;
        }
 
        .btn-mobile-cta:hover { 
            opacity: 0.88; 
            transform: translateY(-1px); 
        }
 
        .btn-mobile-cta.primary {
            background: var(--secundario-amarillo);
            color: var(--secundario-marron);
        }
 
        .btn-mobile-cta.secondary {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
 
        .mobile-contact-info {
            margin-top: 1.2rem;
            padding-top: 1.2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
 
        .mobile-contact-info a {
            color: rgba(255, 255, 255, 0.55);
            text-decoration: none;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.2s;
