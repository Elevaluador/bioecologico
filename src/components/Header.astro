import logoDestok from '../assets/banner-logo-bioecologico-sullana.webp';
import logoMobile from '../assets/banner-logo-bioecologico-sullana-mobil.webp';

interface Props {
    desktopImage?: ImageMetadata;
    mobileImage?: ImageMetadata;
}

const {
    desktopImage = logoDestok,
    mobileImage = logoMobile,
} = Astro.props;

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
