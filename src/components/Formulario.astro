// ============ ESTADO ============

let formData: Partial<FormData> = {};
let currentStep: number = 1;

// ============ HELPERS ============

function getElement(id: string): HTMLElement {
  const el = document.getElementById(id);
  if (!el) throw new Error(`Elemento #${id} no encontrado`);
  return el;
}

function getInput(id: string): HTMLInputElement {
  const el = getElement(id);
  if (!(el instanceof HTMLInputElement)) throw new Error(`#${id} no es un input`);
  return el;
}

function getSelect(id: string): HTMLSelectElement {
  const el = getElement(id);
  if (!(el instanceof HTMLSelectElement)) throw new Error(`#${id} no es un select`);
  return el;
}

function getTextarea(id: string): HTMLTextAreaElement {
  const el = getElement(id);
  if (!(el instanceof HTMLTextAreaElement)) throw new Error(`#${id} no es un textarea`);
  return el;
}

function querySelector<T extends Element>(selector: string): T | null {
  return document.querySelector<T>(selector);
}

function querySelectorAll<T extends Element>(selector: string): NodeListOf<T> {
  return document.querySelectorAll<T>(selector);
}

// ============ FUNCIONES PRINCIPALES ============

function mostrarMensaje(mensaje: string, tipo: 'error' | 'success' | 'warning' = 'error'): void {
  const mensajeDiv = getElement('mensajeFormulario');
  mensajeDiv.textContent = mensaje;
  mensajeDiv.className = tipo;
  mensajeDiv.style.display = 'block';

  mensajeDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  if (tipo === 'success') {
    setTimeout(() => {
      mensajeDiv.style.display = 'none';
    }, 5000);
  }
}

function nextStep(step: number): void {
  const currentStepElement = querySelector<HTMLElement>(`.form-step[data-step="${currentStep}"]`);
  if (!currentStepElement) return;

  const requiredFields = currentStepElement.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]');
  let isValid = true;
  const camposFaltantes: string[] = [];

  requiredFields.forEach((field) => {
    if (!field.checkValidity()) {
      isValid = false;
      field.style.borderColor = '#ff6b6b';
      field.style.boxShadow = '0 0 0 3px rgba(255, 107, 107, 0.2)';

      const label = field.parentElement?.querySelector('label')?.textContent || field.name;
      camposFaltantes.push(label);
    } else {
      field.style.borderColor = '#e0e0e0';
      field.style.boxShadow = 'none';
    }
  });

  if (!isValid) {
    const mensaje = `❌ Por favor verifica que los siguientes campos estén completos antes de continuar:\n\n${camposFaltantes.map((c) => '• ' + c).join('\n')}`;
    mostrarMensaje(mensaje, 'error');
    return;
  }

  getElement('mensajeFormulario').style.display = 'none';

  const currentFormStep = querySelector<HTMLElement>(`.form-step[data-step="${currentStep}"]`);
  const currentIndicator = querySelector<HTMLElement>(`.step[data-step="${currentStep}"]`);
  if (currentFormStep) currentFormStep.classList.remove('active');
  if (currentIndicator) {
    currentIndicator.classList.add('completed');
    currentIndicator.classList.remove('active');
  }

  currentStep = step;

  const nextFormStep = querySelector<HTMLElement>(`.form-step[data-step="${step}"]`);
  const nextIndicator = querySelector<HTMLElement>(`.step[data-step="${step}"]`);
  if (nextFormStep) nextFormStep.classList.add('active');
  if (nextIndicator) nextIndicator.classList.add('active');

  if (step === 4) {
    generateRecommendation();
  }

  getElement('contacto').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function previousStep(step: number): void {
  const currentFormStep = querySelector<HTMLElement>(`.form-step[data-step="${currentStep}"]`);
  const currentIndicator = querySelector<HTMLElement>(`.step[data-step="${currentStep}"]`);
  if (currentFormStep) currentFormStep.classList.remove('active');
  if (currentIndicator) currentIndicator.classList.remove('active');

  currentStep = step;

  const prevFormStep = querySelector<HTMLElement>(`.form-step[data-step="${step}"]`);
  const prevIndicator = querySelector<HTMLElement>(`.step[data-step="${step}"]`);
  if (prevFormStep) prevFormStep.classList.add('active');
  if (prevIndicator) prevIndicator.classList.add('active');

  getElement('contacto').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function updateCultivoInfo(): void {
  const cultivo = getSelect('cultivo').value;
  const infoDiv = getElement('cultivoInfo');

  if (cultivo && cultivo !== 'otro' && cultivoData[cultivo]) {
    const data = cultivoData[cultivo];
    infoDiv.style.display = 'block';
    infoDiv.innerHTML = `
      <h4 style=color:var(--secundario-amarillo);font-size:1.1rem;>${data.icon} Problemas Comunes en ${data.nombre}</h4>
      <ul style="margin: 0.5rem 0; padding-left: 1.5rem;">
        ${data.problemas.map((p) => `<li style="margin: 0.3rem 0;">${p}</li>`).join('')}
      </ul>
    `;
  } else {
    infoDiv.style.display = 'none';
  }
  calculatePotential();
}

function calculatePotential(): void {
  const cultivo = getSelect('cultivo').value;
  const hectareas = getSelect('hectareas').value;
  const potentialDiv = getElement('potentialSavings');

  if (cultivo && hectareas && cultivo !== 'otro' && cultivoData[cultivo]) {
    const data = cultivoData[cultivo];
    let hectareasNum = 0;

    switch (hectareas) {
      case '1-5': hectareasNum = 3; break;
      case '6-10': hectareasNum = 8; break;
      case '11-20': hectareasNum = 15; break;
      case '21-50': hectareasNum = 30; break;
      case '+50': hectareasNum = 70; break;
    }

    const ahorroPorHa = 800;
    const ahorroTotal = hectareasNum * ahorroPorHa * (data.ahorroPotencial / 100);
    const aumentoRendimiento = data.ahorroPotencial / 10;

    potentialDiv.style.display = 'block';
    potentialDiv.innerHTML = `
      <h4 style=color:var(--secundario-amarillo);font-size:1.1rem;>💰 Potencial de Mejora Estimado</h4>
      <div class="potential-stat">
        <span>Reducción de costos:</span>
        <strong style="color:var(--secundario-amarillo);">${data.ahorroPotencial}%</strong>
      </div>
      <div class="potential-stat">
        <span>Ahorro anual estimado:</span>
        <strong style="color:var(--secundario-amarillo);">S/ ${ahorroTotal.toLocaleString()}</strong>
      </div>
      <div class="potential-stat">
        <span>Aumento de rendimiento:</span>
        <strong style="color: var(--secundario-amarillo);">+${aumentoRendimiento}%</strong>
      </div>
      <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--secundario-amarillo);">
        *Estimaciones basadas en resultados promedio con agricultores similares
      </p>
    `;
  } else {
    potentialDiv.style.display = 'none';
  }
}

function updateDiagnosis(): void {
  const problemas = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="problemas"]:checked'))
    .map((cb) => cb.value);
  const diagnosisDiv = getElement('diagnosisResult');

  if (problemas.length > 0) {
    diagnosisDiv.style.display = 'block';
    diagnosisDiv.innerHTML = `
      <h4>🔍 Análisis de tu Situación</h4>
      ${problemas.map((p) => {
        const info = problemasInfo[p];
        if (!info) return '';
        return `
          <div class="problem-item">
            <strong>${info.titulo}</strong>
            <p style="margin: 0.5rem 0; font-size: 0.9rem;">${info.descripcion}</p>
            <p style="margin: 0.5rem 0; color: var(--secundario-amarillo); font-size: 0.9rem;">
              ✓ <em style="color: var(--secundario-amarillo);">${info.impacto}</em>
            </p>
          </div>
        `;
      }).join('')}
    `;
  } else {
    diagnosisDiv.style.display = 'none';
  }
}

function calculateSavings(): void {
  updateDiagnosis();
}

function generateRecommendation(): void {
  const cultivo = getSelect('cultivo').value;
  const hectareas = getSelect('hectareas').value;
  const problemas = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="problemas"]:checked'))
    .map((cb) => cb.value);
  const gastoMensual = getSelect('gasto_mensual').value;
  const recommendationDiv = getElement('recommendationResult');

  const cultivoInfo = cultivoData[cultivo] || { nombre: 'tu cultivo', ahorroPotencial: 30, soluciones: [] };
  const ahorroAnual = (parseInt(gastoMensual) || 0) * 12 * (cultivoInfo.ahorroPotencial / 100);

  const recomendaciones: Recomendacion[] = [];

  if (cultivo && cultivo !== 'otro') {
    recomendaciones.push({
      titulo: `Plan Específico para ${cultivoInfo.nombre}`,
      descripcion: cultivoInfo.soluciones.join(', ')
    });
  }

  if (problemas.includes('salinidad')) {
    recomendaciones.push({
      titulo: "Programa Anti-Salinidad",
      descripcion: "Aplicación de microorganismos halotolerantes + mejoradores de suelo durante 3 meses"
    });
  }

  if (problemas.includes('bajo_rendimiento')) {
    recomendaciones.push({
      titulo: "Bioestimulación Integral",
      descripcion: "Programa de bioestimulantes foliares + enraizadores + fertilización orgánica balanceada"
    });
  }

  if (problemas.length > 3) {
    recomendaciones.push({
      titulo: "Regeneración Completa del Suelo",
      descripcion: "Plan de 6 meses para recuperar la salud microbiológica y química del suelo"
    });
  }

  if (recomendaciones.length === 0) {
    recomendaciones.push({
      titulo: "Plan de Mantenimiento Preventivo",
      descripcion: "Programa de nutrición balanceada para mantener y mejorar tu rendimiento actual"
    });
  }

  recommendationDiv.innerHTML = `
    <h4 style="color: var(--primario-verde); margin-bottom: 1.5rem; font-size:1rem;">💡 Tu Plan Personalizado Incluye:</h4>
    <div style="background:var(--secundario-marron); padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem; border: 2px solid var(--primario-verde);">
      <p style="margin: 0; font-size: 0.9rem; color: var(--blanco); text-align: center;">Tu Ahorro Potencial Anual</p>
      <h3 style="margin: 0.5rem 0; color: var(--secundario-amarillo); text-align: center;">S/ ${ahorroAnual.toLocaleString()}</h3>
      <p style="margin: 0; font-size: 0.85rem; color: var(--secundario-amarillo); text-align: center;">Reduciendo ${cultivoInfo.ahorroPotencial}% tus costos de fertilización</p>
    </div>
    ${recomendaciones.map((rec) => `
      <div class="recommendation-item">
        <h5>${rec.titulo}</h5>
        <p style="margin: 0.5rem 0; color: #555;">${rec.descripcion}</p>
      </div>
    `).join('')}
    <div class="recommendation-item" style="background: var(--primario-morado); border-left: 3px solid var(--primario-verde);">
      <h5 style="color:var(--secundario-amarillo)">🎯 Próximos Pasos</h5>
      <ol style="margin: 0.5rem 0; padding-left: 1.5rem; color: var(--blanco);">
        <li>Diseño de plan de fertilización personalizado</li>
        <li>Implementación con seguimiento mensual</li>
        <li>Medición de resultados y ajustes</li>
      </ol>
    </div>
  `;
}

function showSuccessScreen(data: Partial<FormData>): void {
  const successScreen = getElement('successScreen');

  getElement('successNombre').textContent = data.nombre || '';

  const cultivoInfo = cultivoData[data.cultivo || ''] || { nombre: data.cultivo || '' };
  getElement('successCultivo').textContent = cultivoInfo.nombre || data.cultivo || '';

  getElement('successUbicacion').textContent = data.ubicacion || '';
  getElement('successAhorro').textContent = `S/ ${data.ahorro_estimado ? data.ahorro_estimado.toLocaleString() : '0'}`;

  const problemasTexto = data.problemas || 'ninguno';
  getElement('successProblemas').textContent = problemasTexto;

  const mensajeWhatsApp = `Hola, acabo de completar el diagnóstico AgTech. Mi nombre es ${data.nombre}, mi cultivo es ${cultivoInfo.nombre || data.cultivo} y tengo ${data.hectareas} hectáreas en ${data.ubicacion} y mis mayores problemas son ${problemasTexto}.`;
  (getElement('whatsappSuccess') as HTMLAnchorElement).href = `https://wa.me/51918005466?text=${encodeURIComponent(mensajeWhatsApp)}`;

  successScreen.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeSuccessScreen(): void {
  const successScreen = getElement('successScreen');
  successScreen.classList.remove('active');
  document.body.style.overflow = 'auto';

  (getElement('contactForm') as HTMLFormElement).reset();

  const currentFormStep = querySelector<HTMLElement>(`.form-step[data-step="${currentStep}"]`);
  const currentIndicator = querySelector<HTMLElement>(`.step[data-step="${currentStep}"]`);
  if (currentFormStep) currentFormStep.classList.remove('active');
  if (currentIndicator) currentIndicator.classList.remove('active');

  querySelectorAll<HTMLElement>('.step').forEach((step) => step.classList.remove('completed'));

  currentStep = 1;

  const firstFormStep = querySelector<HTMLElement>(`.form-step[data-step="1"]`);
  const firstIndicator = querySelector<HTMLElement>(`.step[data-step="1"]`);
  if (firstFormStep) firstFormStep.classList.add('active');
  if (firstIndicator) firstIndicator.classList.add('active');

  getElement('cultivoInfo').style.display = 'none';
  getElement('potentialSavings').style.display = 'none';
  getElement('diagnosisResult').style.display = 'none';
  getElement('recommendationResult').innerHTML = '';
  getElement('mensajeFormulario').style.display = 'none';

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ============ EVENT LISTENERS ============

document.addEventListener('DOMContentLoaded', () => {
  const form = getElement('contactForm') as HTMLFormElement;

  getSelect('cultivo').addEventListener('change', updateCultivoInfo);
  getSelect('hectareas').addEventListener('change', calculatePotential);
  getSelect('gasto_mensual').addEventListener('change', calculateSavings);

  form.addEventListener('change', (e: Event) => {
    const target = e.target as HTMLElement;
    if (target.matches('input[name="problemas"]')) {
      updateDiagnosis();
    }
  });

  form.addEventListener('click', (e: MouseEvent) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;

    if (btn.classList.contains('btn-next')) {
      e.preventDefault();
      const nextStepNum = parseInt(btn.dataset.next || '1');
      nextStep(nextStepNum);
    }

    if (btn.classList.contains('btn-back')) {
      e.preventDefault();
      const prevStepNum = parseInt(btn.dataset.next || '1');
      previousStep(prevStepNum);
    }
  });

  form.addEventListener('submit', async (e: SubmitEvent) => {
    e.preventDefault();

    const submitButton = form.querySelector('.submit-button') as HTMLButtonElement;
    const originalText = submitButton.textContent || 'Enviar';
    submitButton.textContent = 'Enviando... ⏳';
    submitButton.disabled = true;

    try {
      const problemas = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="problemas"]:checked'))
        .map((cb) => cb.value);
      const cultivo = getSelect('cultivo').value;
      const hectareas = getSelect('hectareas').value;
      const gastoMensual = parseInt(getSelect('gasto_mensual').value) || 0;

      const cultivoInfo = cultivoData[cultivo] || { ahorroPotencial: 30 };
      const ahorroEstimado = gastoMensual * 12 * (cultivoInfo.ahorroPotencial / 100);

      formData = {
        nombre: getInput('nombre').value,
        telefono: getInput('telefono').value,
        ubicacion: getInput('ubicacion').value,
        cultivo: cultivo,
        hectareas: hectareas,
        anos_cultivando: getSelect('anos').value,
        problemas: problemas.join(', '),
        fertilizante_actual: getSelect('fertilizante_actual').value,
        gasto_mensual: getSelect('gasto_mensual').value,
        tipo_interes: getSelect('interes').value,
        comentarios: getTextarea('comentarios').value || null,
        ahorro_estimado: Math.round(ahorroEstimado),
        estado: 'nuevo'
      };

      const response = await fetch('/api/diagnostico', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      });

      const result = await response.json();

      if (!response.ok) {
        if (response.status === 409) {
          mostrarMensaje('⚠️ Ya existe un diagnóstico registrado para este teléfono y cultivo. Nuestro equipo técnico revisará la información y se comunicará contigo.', 'warning');
          submitButton.textContent = originalText;
          submitButton.disabled = false;
          return;
        }
        throw new Error(result.error || 'Error al guardar');
      }

      const savedForms: (Partial<FormData> & { timestamp: string })[] = JSON.parse(localStorage.getItem('agtech_forms') || '[]');
      savedForms.push({
        ...formData,
        timestamp: new Date().toISOString()
      });
      localStorage.setItem('agtech_forms', JSON.stringify(savedForms));

      showSuccessScreen(formData);

    } catch (error) {
      console.error('Error al procesar el formulario:', error);
      mostrarMensaje('❌ Hubo un error al enviar el formulario. Por favor, intenta contactarnos directamente por WhatsApp: +51 918 005 466', 'error');
    } finally {
      submitButton.textContent = originalText;
      submitButton.disabled = false;
    }
  });

  getInput('telefono').addEventListener('input', function(this: HTMLInputElement) {
    this.value = this.value.replace(/[^0-9]/g, '');
  });

  const requiredFields = document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input[required], select[required], textarea[required]');
  requiredFields.forEach((field) => {
    const handleInput = (): void => {
      if (field.value.trim() !== '') {
        field.style.borderColor = '#4CAF50';
        field.style.boxShadow = '0 0 0 3px rgba(76, 175, 80, 0.1)';
      } else {
        field.style.borderColor = '#e0e0e0';
        field.style.boxShadow = 'none';
      }
    };

    field.addEventListener('input', handleInput);
    field.addEventListener('change', handleInput);
  });

  const observerOptions: IntersectionObserverInit = {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const target = entry.target as HTMLElement;
        target.style.opacity = '1';
        target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  document.querySelectorAll<HTMLElement>('.stat-card, .solution-card').forEach((card) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(30px)';
    card.style.transition = 'all 0.6s ease';
    observer.observe(card);
  });
});
// Cerrar pantalla de éxito
    const closeBtn = document.getElementById('closeSuccessBtn');
    if (closeBtn) {
        closeBtn.addEventListener('click', closeSuccessScreen);
    }

    // Volver al inicio
    const backLink = document.getElementById('backToHome');
    if (backLink) {
        backLink.addEventListener('click', function(e) {
            e.preventDefault();
            closeSuccessScreen();
        });
    }
</script>